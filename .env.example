# Database Configuration (Supabase/PostgreSQL)
# Transaction Mode (for app logic)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:6543/postgres?pgbouncer=true"
# Session Mode (for migrations)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres"

# Backend Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration (Comma separated allowed origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Firebase Configuration
# FIREBASE_PROJECT_ID=...
# FIREBASE_CLIENT_EMAIL=...
# FIREBASE_PRIVATE_KEY=...
